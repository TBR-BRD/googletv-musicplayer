<resources>
    <!-- Plain platform theme (no extra dependency) - Compose owns all real UI,
         this only sets the window background/no-action-bar before Compose
         takes over. -->
    <style name="Theme.OnRadioTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
